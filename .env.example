# ==============================================================================
# PromptPro Chrome Extension (Root) — Build & Development Environment Template
# Copy this file to .env.local if custom build-time overrides are needed.
# ==============================================================================

# Web Dashboard API Base URL (used for sync & authentication)
NEXT_PUBLIC_APP_URL=https://prompt-pro-liart.vercel.app

# PostHog Telemetry (Client Project Key — Public by design)
# Obtain from: PostHog Project Settings → Project API Key
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.posthog.com
