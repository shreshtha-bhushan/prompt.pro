# ==============================================================================
# PromptPro Dashboard (web/) — Environment Variables Template
# Copy this file to web/.env.local and populate with your active credentials.
# NEVER commit .env or .env.local files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# Obtain from: Clerk Dashboard → API Keys (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 2. Supabase Backend & Database
# Obtain from: Supabase Dashboard → Project Settings → API (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. AI / OpenRouter API
# Obtain from: OpenRouter Dashboard → Keys (https://openrouter.ai/keys)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Whop Billing & Memberships
# Obtain from: Whop Developer Dashboard → API Keys & Webhooks (https://dash.whop.com)
# ------------------------------------------------------------------------------
WHOP_API_KEY=whop_api_key_xxxxxxxxxxxxxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=whop_webhook_secret_xxxxxxxxxxxx
WHOP_PLUS_PRODUCT_ID=prod_xxxxxxxx
WHOP_MAX_PRODUCT_ID=prod_xxxxxxxx
WHOP_PLUS_PLAN_ID_MONTHLY=plan_xxxxxxxx
WHOP_PLUS_PLAN_ID_ANNUAL=plan_xxxxxxxx
WHOP_MAX_PLAN_ID_MONTHLY=plan_xxxxxxxx
WHOP_MAX_PLAN_ID_ANNUAL=plan_xxxxxxxx

# ------------------------------------------------------------------------------
# 5. PostHog Product Analytics
# Obtain from: PostHog Project Settings → Project API Key & Project ID (https://us.posthog.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=12345
# Personal API key only needed for admin setup scripts (Account Settings → Personal API Keys)
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. Upstash Serverless Redis (Rate Limiting)
# Obtain from: Upstash Console → Redis Databases (https://console.upstash.com)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_placeholder_here

# ------------------------------------------------------------------------------
# 7. Application URL (CORS & Base URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://prompt-pro-liart.vercel.app

